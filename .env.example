# ─────────────────────────────────────────────────────────────────────────────
# Remindora environment. Copy to .env and fill in. Never commit .env.
# Generate 32-byte keys with:  openssl rand -base64 32
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=info
PORT=4000

API_PUBLIC_URL=http://localhost:4000
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,tauri://localhost,http://tauri.localhost
APP_DEEP_LINK_SCHEME=remindora

# Local infra: `npm run local:infra` (embedded, no Docker) or `docker compose up -d`.
DATABASE_URL=postgresql://remindora:remindora@localhost:54329/remindora
REDIS_URL=redis://localhost:63799

# ── Secrets (REQUIRED; 32 bytes each, base64 or hex) ──
JWT_SECRET=
ENCRYPTION_KEY=
PAIRING_KEY=
OTP_PEPPER=
COOKIE_SECURE=false
# COOKIE_DOMAIN=.remindora.app

# ── Email (console prints codes/links to the API log in development) ──
EMAIL_PROVIDER=console
EMAIL_FROM="Remindora <no-reply@remindora.app>"
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# RESEND_API_KEY=
# BREVO_API_KEY=   # EMAIL_PROVIDER=brevo: HTTPS API, works where SMTP ports are blocked

# ── OAuth (optional; buttons hide when unset) ──
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=

# ── Push ──
# Firebase Cloud Messaging HTTP v1 (service account with "Firebase Cloud Messaging API Admin")
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Web Push VAPID keys: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@remindora.app

# ── S3-compatible storage (AWS S3, Cloudflare R2, MinIO…) ──
# S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=remindora-attachments
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ── Billing ── (dev = instant local upgrades; stripe for real payments)
BILLING_PROVIDER=dev
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PREMIUM_MONTHLY=
# STRIPE_PRICE_PREMIUM_YEARLY=
# STRIPE_PRICE_TEAM_MONTHLY=

# ── AI ── (heuristic = deterministic local planner; anthropic = Claude)
AI_PROVIDER=heuristic
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5

# ── Observability ──
# SENTRY_DSN=

# Enables dev-only endpoints (instant plan activation). Never in production.
DEV_TOOLS=true

# ── Clients ──
NEXT_PUBLIC_API_URL=http://localhost:4000
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
