{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Remindora",
  "version": "0.2.3",
  "identifier": "app.remindora.desktop",
  "build": {
    "frontendDist": "../../web/out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "",
    "beforeBuildCommand": "npm run build:desktop -w @remindora/web"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Remindora",
        "width": 1280,
        "height": 820,
        "minWidth": 380,
        "minHeight": 560,
        "backgroundColor": "#070D22",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "url": "/app/today/"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost https://api-production-1921.up.railway.app wss://api-production-1921.up.railway.app https://api.github.com http://localhost:4000 ws://localhost:4000",
        "img-src": "'self' data: blob: https:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Tasks, calendar, habits and priority reminders",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": [
          "libsecret-1-0"
        ]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "remindora"
        ]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/Jonathansakafu/Remindora/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY0OTgwQjZGMTdEODUyMkUKUldRdVV0Z1hid3VZOU1xa3ZVcitOdnVQeHhma1lZelM1aEZTNjF3TTF4LzZLK1JWQjdFTkI5QU4K"
    }
  }
}
