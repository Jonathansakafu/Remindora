{
  "name": "@remindora/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "concurrently -k -n tsc,api \"tsc -p tsconfig.build.json -w --preserveWatchOutput\" \"node --env-file-if-exists=../../.env --watch-path=dist --enable-source-maps dist/main.js\"",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unit --passWithNoTests",
    "test:e2e": "vitest run --project e2e",
    "openapi": "node --env-file-if-exists=../../.env dist/openapi.js"
  },
  "devDependencies": {
    "@socket.io/redis-emitter": "^5.1.0",
    "@swc/core": "^1.13.5",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.20.5",
    "@types/sanitize-html": "^2.16.0",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.1",
    "pino": "^9.13.0",
    "pino-pretty": "^13.1.1",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.1.4",
    "unplugin-swc": "^1.5.7",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@aws-sdk/client-s3": "^3.913.0",
    "@aws-sdk/s3-request-presigner": "^3.913.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/platform-socket.io": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/websockets": "^11.1.6",
    "@remindora/auth": "0.1.0",
    "@remindora/config": "0.1.0",
    "@remindora/core": "0.1.0",
    "@remindora/database": "0.1.0",
    "@remindora/entitlements": "0.1.0",
    "@remindora/notifications": "0.1.0",
    "@remindora/types": "0.1.0",
    "@sentry/node": "^10.20.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bullmq": "^5.61.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.0",
    "luxon": "^3.7.2",
    "nestjs-pino": "^4.4.1",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "^2.17.0",
    "socket.io": "^4.8.1",
    "zod": "^4.6.7"
  }
}
