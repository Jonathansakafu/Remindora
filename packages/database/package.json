{
  "name": "@remindora/database",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate:deploy": "node --env-file-if-exists=../../.env ../../node_modules/prisma/build/index.js migrate deploy",
    "migrate:dev": "node --env-file-if-exists=../../.env ../../node_modules/prisma/build/index.js migrate dev",
    "migrate:diff": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script",
    "seed": "node --env-file-if-exists=../../.env --import tsx prisma/seed.ts",
    "studio": "node --env-file-if-exists=../../.env ../../node_modules/prisma/build/index.js studio"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@remindora/core": "0.1.0",
    "@remindora/entitlements": "0.1.0",
    "@remindora/notifications": "0.1.0",
    "luxon": "^3.7.2"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.18.0",
    "prisma": "6.19.3",
    "tsx": "^4.20.6"
  }
}
