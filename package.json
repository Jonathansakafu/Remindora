{
  "name": "remindora",
  "private": true,
  "version": "0.1.0",
  "description": "Remindora — personal and team task management for Web, Desktop and Android.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=./packages/*",
    "dev": "turbo run dev --parallel --filter=@remindora/api --filter=@remindora/workers --filter=@remindora/web",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "npm run test:e2e -w @remindora/api && npm run test:e2e -w @remindora/web",
    "db:generate": "npm run generate -w @remindora/database",
    "db:migrate": "npm run migrate:deploy -w @remindora/database",
    "db:seed": "npm run seed -w @remindora/database",
    "local:infra": "node scripts/local-infra.mjs",
    "openapi": "npm run openapi -w @remindora/api"
  },
  "devDependencies": {
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "prettier": "3.6.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
